{
  "name": "graybox",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:projects": "tsx scripts/generate-projects.ts",
    "generate:projects:watch": "tsx scripts/generate-projects.ts --watch",
    "predev": "npm run generate:projects",
    "prebuild": "npm run generate:projects",
    "dev": "concurrently -n next,content -c blue,green \"next dev\" \"npm run generate:projects:watch\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.1.6",
    "gray-matter": "^4.0.3",
    "lorem-ipsum": "^3.0.0",
    "next": "14.2.5",
    "next-mdx-remote": "^6.0.0",
    "pnpm": "^9.6.0",
    "react": "^18",
    "react-dom": "^18",
    "react-ga4": "^2.1.0",
    "sugar-high": "^0.7.0",
    "three": "^0.185.1",
    "yarn": "^1.22.22"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.7",
    "@tailwindcss/typography": "^0.5.20",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "concurrently": "^10.0.5",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
